### What command do we want to run? 
# the $(dataset) variable is set in the final `queue` statement
shell = Rscript spill_calculation.ospool.R $(dataset)

### What files do we need? 
transfer_input_files = spill_calculation.ospool.Rm, data/$(dataset)

### set the R environment with a container
container_image = /cvmfs/singularity.opensciencegrid.org/opensciencegrid/osgvo-r:3.5.0

# Specify other job options
+JobDurationCategory = "Medium"
should_transfer_files = YES

request_cpus   = 1
request_memory = 1GB
request_disk   = 1GB

log    = log/$(dataset).log
output = output/$(dataset).out
error  = error/$(dataset).error

### Set the "dataset" variable and queue one job
dataset = spills_1950_1959.csv
queue 1